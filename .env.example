# ============================================================
# BetterBee — Production Environment Variables Template
# Copy to backend/.env and frontend/.env.local
# ============================================================

# --- App Settings ---
APP_NAME=BetterBee
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "https://your-domain.com"]

# --- PostgreSQL Database ---
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/betterbee
# Production (Supabase / Render / Neon): postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/betterbee

# --- Background Task Queue & Redis ---
# ASYNC_MODE: "celery" (production worker) or "sync" / "fastapi"
ASYNC_MODE=celery
REDIS_URL=redis://localhost:6379/0

# --- Storage Provider (AWS S3) ---
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# For MinIO or custom S3 endpoint (optional):
# S3_ENDPOINT_URL=http://localhost:9000

# --- Clerk Authentication ---
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_JWKS_URL=https://your-clerk-app.clerk.accounts.dev/.well-known/jwks.json

# --- Frontend (.env.local) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI & LLM Providers ---
# Options: groq | openai | anthropic | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Embeddings & RAG Configuration ---
# Options: huggingface | openai | gemini | ollama
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranker Options: cross-encoder | none
RERANKER_PROVIDER=cross-encoder

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_PREFIX=workspace_

# RAG Chunker & Retriever Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
